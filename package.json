{
  "name": "ghast-shooting",
  "productName": "가스트 사격 3",
  "version": "3.6.0",
  "description": "가스트 사격 — 학교 행사용 라이트건 사격 게임",
  "author": "SYNC",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "app": "electron .",
    "build:exe": "node desktop/build.js",
    "build:mac": "node desktop/build.js mac",
    "test": "node --test \"tests/*.test.js\""
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "kr.gvcs.ghast-shooting-3",
    "productName": "가스트 사격 3",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/gun-mode.js",
      "desktop/gun-mode-worker.js",
      "desktop/smoke-check.js",
      "desktop/field-log.js",
      "index.html",
      "style.css",
      "game.js",
      "game-ghasts.js",
      "game-fx.js",
      "game-ranking.js",
      "game-play.js",
      "game-guns.js",
      "game-ui.js",
      "game-text.js",
      "game-screens.js",
      "game-loop.js",
      "tournament-core.js",
      "league-core.js",
      "roster-core.js",
      "aim-cap.js",
      "rapid-detect.js",
      "rank-rules.js",
      "ghast-art.js",
      "icon-art.js",
      "pixel-scale.js",
      "nether-bg.js",
      "fx-core.js",
      "contest-csv.js",
      "contest-manage.js",
      "tournament.js",
      "league.js",
      "solo.js",
      "assets/**",
      "fonts/**",
      "package.json"
    ],
    "mac": {
      "icon": "desktop/icon.png"
    },
    "win": {
      "icon": "desktop/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "가스트 사격 3",
      "runAfterFinish": true,
      "artifactName": "ghast-shooting-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "ghast-shooting-${version}-portable.${ext}"
    },
    "copyright": "Copyright © 2026 SYNC"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  }
}
